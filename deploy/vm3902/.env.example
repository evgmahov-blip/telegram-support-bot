# Copy to .env on VM3902 with mode 0600. Replace every placeholder.
# Never commit the resulting file.
MONGO_ROOT_USERNAME=most_root
MONGO_ROOT_PASSWORD=REPLACE_WITH_STRONG_BOOTSTRAP_PASSWORD
MONGO_APP_USERNAME=most_support
MONGO_APP_PASSWORD=REPLACE_WITH_STRONG_APPLICATION_PASSWORD
MONGO_APP_DATABASE=support
# URL-encode credentials when constructing this URI.
MONGO_URI=mongodb://most_support:REPLACE_WITH_URL_ENCODED_APPLICATION_PASSWORD@mongodb:27017/support?authSource=support
