# Copy to .env and replace every placeholder.

# Mongo bootstrap/admin account. The support bot never uses these credentials.
MONGO_ROOT_USERNAME=most_root
MONGO_ROOT_PASSWORD=replace_with_a_different_strong_root_password

# Least-privilege application account created only on first initialization of an empty Mongo volume.
MONGO_APP_USERNAME=most_support
MONGO_APP_PASSWORD=replace_with_a_strong_app_password
MONGO_APP_DATABASE=support

# URL-encode special characters in username/password inside MONGO_URI.
# authSource is the application database because the app user is created there.
MONGO_URI=mongodb://most_support:replace_with_a_strong_app_password@mongodb:27017/support?authSource=support
